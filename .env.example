# Copia este archivo como .env en la raíz del proyecto (cp .env.example .env).

# Entorno: desarrollo (por defecto) o produccion.
# En produccion la app NO arranca si falta SECRET_KEY o ANON_SALT (mín. 32 caracteres la primera)
# o si DATABASE_URL es SQLite. En desarrollo se generan valores temporales como antes.
ENTORNO=desarrollo

# Base de datos. Por defecto SQLite (archivo backend/desafios_sql.db).
# Producción con Neon: postgresql+psycopg://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# (si pegas la cadena de Neon tal cual, con prefijo postgresql://, se convierte sola a postgresql+psycopg://)
DATABASE_URL=sqlite:///backend/desafios_sql.db
# Pool de conexiones PostgreSQL (opcional; SQLite lo ignora). Valores por defecto:
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=280
# Esquema: vacío = automático (desarrollo: create_all; producción: Alembic, ver docs/MIGRACIONES.md).
# CREAR_TABLAS_AUTO=

# Clave para firmar los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la dejas vacía (solo en desarrollo) se crea una temporal y las sesiones se pierden al reiniciar el servidor.
# En producción es obligatoria (Render la genera con generateValue, ver render.yaml).
SECRET_KEY=

# Minutos de vigencia del token de sesión.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos por CORS, separados por comas.
# En producción: la URL EXACTA de Vercel, con https y SIN barra final. Ej.: https://mi-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Dominio institucional exigido en el registro (p. ej. uni.edu). Varios: separados por comas.
# Vacío = se acepta cualquier correo.
DOMINIO_INSTITUCIONAL=

# Usuario demo (solo desarrollo). Ponlo en false para no crearlo (en producción: false).
SEED_USUARIO_DEMO=true
DEMO_EMAIL=estudiante@demo.edu
DEMO_PASSWORD=Demo12345!

# Docente de pruebas (opcional). Vacíos = no se crea. Si el correo ya existe, no se modifica.
DOCENTE_EMAIL=
DOCENTE_PASSWORD=

# Primer administrador (opcional). Vacíos = no se crea. Si el correo ya existe, no se modifica.
# Con esta cuenta se nombra a los docentes desde la página «Usuarios». Cambia la contraseña de ejemplo.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sandbox SQL de los desafíos: segundos máximos por consulta del estudiante y filas máximas que se devuelven.
SANDBOX_TIEMPO_MAX_SEG=2
SANDBOX_MAX_FILAS=200

# Ayuda con IA. LLM_PROVIDER: mock (por defecto, modo demostración), groq, anthropic u openai.
LLM_PROVIDER=mock
# Modelo que se usa cuando LLM_PROVIDER=anthropic.
LLM_MODEL=claude-haiku-5-5
# Clave de Anthropic. NO la subas al repositorio. Vacía = la ayuda cae al modo demostración sin error.
ANTHROPIC_API_KEY=
# Temperatura, tokens y tiempo límite del LLM se leen de backend/app/config/llm.json.

# Groq (LLM_PROVIDER=groq). NO subas la clave al repositorio.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# OpenAI (LLM_PROVIDER=openai). La clave solo se configura en el servidor.
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Sal para los seudónimos de los reportes (HMAC-SHA256 del id de usuario). Descomenta y genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# En desarrollo, si no la defines se usa una temporal y los seudónimos cambian en cada reinicio.
# En producción es obligatoria y no debe cambiar después. No la subas al repositorio.
# ANON_SALT=
