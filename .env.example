# Copia este archivo como .env en la raíz del proyecto (cp .env.example .env).

# Base de datos. Por defecto SQLite (archivo backend/desafios_sql.db).
# Para PostgreSQL más adelante: postgresql+psycopg://usuario:clave@host:5432/basedatos
DATABASE_URL=sqlite:///backend/desafios_sql.db

# Clave para firmar los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la dejas vacía se crea una temporal y las sesiones se pierden al reiniciar el servidor.
SECRET_KEY=

# Minutos de vigencia del token de sesión.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173

# Dominio institucional exigido en el registro (p. ej. uni.edu). Varios: separados por comas.
# Vacío = se acepta cualquier correo.
DOMINIO_INSTITUCIONAL=

# Usuario demo (solo desarrollo). Ponlo en false para no crearlo.
SEED_USUARIO_DEMO=true
DEMO_EMAIL=estudiante@demo.edu
DEMO_PASSWORD=Demo12345!
